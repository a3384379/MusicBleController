<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.musicble.ios-reinstall</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CHECKER_SCRIPT__</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>WorkingDirectory</key>
  <string>__RUNNER_DIR__</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/music_ble_deploy/ios-reinstall.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/music_ble_deploy/ios-reinstall.err.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
