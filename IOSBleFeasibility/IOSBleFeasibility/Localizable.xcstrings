{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "歌词设置" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lyric settings"}}}},
    "歌词显示设置" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lyric display settings"}}}},
    "灵动岛歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Dynamic Island lyrics"}}}},
    "显示样式" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Appearance"}}}},
    "背景配色" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Background color"}}}},
    "暖棕" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Brown"}}}},
    "薄荷" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mint"}}}},
    "雾蓝" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Blue"}}}},
    "淡紫" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lilac"}}}},
    "玫瑰" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Rose"}}}},
    "深灰" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Slate"}}}},
    "已选择" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Selected"}}}},
    "未选择" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not selected"}}}},
    "单行" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Single line"}}}},
    "双行" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Two lines"}}}},
    "显示歌名" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show song title"}}}},
    "显示悬浮歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show floating lyrics"}}}},
    "点击显示悬浮歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Tap to show floating lyrics"}}}},
    "悬浮歌词行数" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Floating lyric rows"}}}},
    "紧凑态保留封面，固定区域显示当前歌词；长按查看更多歌词，多活动时由系统选择最小态。" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Keep artwork and show lyrics in a fixed compact area. Touch and hold for more lyrics; the system selects the minimal view when activities compete."}}}},
    "开启后自动显示，窗口准备好后返回播放器。关闭窗口不暂停 Sony 播放。" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enable to show lyrics and return to the player when ready. Closing the window does not pause Sony playback."}}}},
    "轻点窗口可收起系统控件，双指缩放可调整大小。" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Tap the window to hide system controls, and pinch to resize."}}}},
    "歌词预览尚未显示，请留在设置页重试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The lyric preview is not visible. Stay in Settings and try again."}}}},
    "歌词预览未准备完成，请再次尝试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The lyric preview is not ready. Please try again."}}}},
    "画中画启动未获系统确认，请再次尝试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Picture in Picture did not finish starting. Please try again."}}}},
    "系统尚未允许画中画，请再次尝试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Picture in Picture is not available yet. Please try again."}}}},
    "播放控制已发送，等待确认" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Playback control sent. Waiting for confirmation."}}}},
    "播放控制结果未知，请回到应用重新连接后重试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Playback result unknown. Return to the app, reconnect, then try again."}}}},
    "播放控制未执行，状态同步后可重试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Playback control was not executed. Sync the state, then try again."}}}},
    "灵动岛显示歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show lyrics in Dynamic Island"}}}},
    "在紧凑态优先显示当前歌词；长句会截断，多活动时由系统选择最小态。" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Prioritize lyrics in the compact view. Long lines are truncated; the system chooses the minimal view when multiple activities compete."}}}},
    "悬浮歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Floating lyrics"}}}},
    "通过系统画中画在其他应用上方显示歌词。关闭窗口不暂停 Sony 播放。" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show lyrics above other apps using Picture in Picture. Closing the window does not pause Sony playback."}}}},
    "前奏" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Intro"}}}},
    "间奏" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Instrumental"}}}},
    "歌词加载中" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Loading lyrics"}}}},
    "连接已断开" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disconnected"}}}},
    "歌词已过期，等待同步" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lyrics are out of date. Waiting to sync."}}}},
    "未开启" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disabled"}}}},
    "准备中" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preparing"}}}},
    "可以显示" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Ready"}}}},
    "正在显示" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Starting"}}}},
    "已显示" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Visible"}}}},
    "正在停止" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stopping"}}}},
    "暂不可用" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unavailable"}}}},
    "显示失败" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Failed to display"}}}},
    "请回到应用中显示悬浮歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Return to the app to show floating lyrics."}}}},
    "此设备不支持画中画" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This device does not support Picture in Picture."}}}},
    "无法准备画中画音频会话" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not prepare the Picture in Picture audio session"}}}},
    "系统暂时无法显示画中画，请再次尝试" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Picture in Picture is unavailable right now. Try again."}}}},
    "无法绘制悬浮歌词" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not render floating lyrics."}}}},
    "播放状态未同步，无法执行控制" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Playback is not synchronized. Controls are unavailable."}}}},
    "悬浮歌词预览" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Floating lyrics preview"}}}},
    "停止显示" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stop displaying"}}}},
    "再次显示" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Show again"}}}},
    "诊断暂不可用，请确认连接后重试" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Diagnostics unavailable. Check the connection and try again."}}}},
    "诊断请求超时，请重试" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Diagnostics request timed out. Try again."}}}},
